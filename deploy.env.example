# Deployment settings — COPY THIS FILE, do not edit it in place.
#
#   cp deploy.env.example deploy.env        # ./deploy.env is gitignored
#   cp deploy.env.example ~/.agora/deploy.env   # or keep it outside the repo entirely
#
# The Makefile `-include`s both paths, so either works and neither is required.
# Precedence, lowest to highest:
#   Makefile defaults < ~/.agora/deploy.env < ./deploy.env < environment < make VAR=…
#
# This file is the only one of the three that is committed, and it must never
# contain a real host, key path, or credential.

# Public IP or DNS name of the target host. Any SSH-reachable machine works —
# EC2, a VPS, or a VM on your desk.
DEPLOY_HOST = 203.0.113.10

# Login user. `ubuntu` for Ubuntu images, `ec2-user` for Amazon Linux,
# `admin` for Debian. A wrong value looks like an SSH auth failure.
DEPLOY_USER = ubuntu

# Path to your SSH private key.
#
# Point at a key that lives OUTSIDE this repository — ~/.ssh is the obvious
# home. `make check-key` refuses a key stored inside the repo, because that is
# the one mistake that turns a private key into a git object, and git objects
# are hard to un-publish.
#
# Leave this unset to use your ssh-agent or ~/.ssh/config instead; everything
# still works, the Makefile just calls plain ssh.
DEPLOY_KEY = ~/.ssh/agora.pem

# Published port on the host. Must match the inbound rule in your security
# group — the container will look perfectly healthy while being unreachable if
# the port is closed, because /healthz passes from inside.
HOST_PORT = 8080

# Image architecture. preflight-host compares this against the target host and
# prints the fix on a mismatch — the symptom otherwise is `exec format error`,
# which reads like a corrupt transfer rather than a platform problem.
#   linux/amd64   t2 / t3 / t5 and most x86 VPS hosts
#   linux/arm64   Graviton (t4g, c7g, m7g), Ampere, Apple-silicon VMs
PLATFORM = linux/amd64

# Anonymity threshold for the deployed instance.
#   2 = family default (anonymity on)
#   1 = cloud parity (anonymity off)
# Confirm what actually took effect with: curl -s http://<host>:8080/healthz | jq .policy
AGORA_K = 2

# Only needed for `make push`.
# DOCKERHUB_REPO = yourname/agora
